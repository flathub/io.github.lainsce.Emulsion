                }
            ]
        },
        {
            "name" : "emulsion",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://github.com/lainsce/emulsion/archive/3.3.9.zip",
                    "sha256" : "634ecd9b85cb90790bee8fdc6494a5d99ff7a7031a5326770620a97db0165ef8"
                }
            ]
        }
    ]
